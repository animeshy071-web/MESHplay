{
  "name": "meshplay",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs && node -e \"import('./scripts/gen-romdb.mjs')\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:gb": "node_modules/.bin/esbuild.cmd scripts/test-gb.ts --bundle --platform=node --format=cjs --outfile=scripts/test-gb.cjs --log-level=error && node scripts/test-gb.cjs",
    "cores": "node scripts/fetch-cores.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "ogl": "^1.0.11",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "agentation": "^3.1.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.2",
    "vite": "^6.0.0"
  }
}
